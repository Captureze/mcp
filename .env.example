# Captureze API key (create one at https://captureze.com/app -> Settings -> API keys)
CAPTUREZE_API_KEY=cap_xxxxxxxxxxxxxxxxxxxxxxxx

# Captureze API base URL. Override for self-hosted / staging installs.
CAPTUREZE_BASE_URL=https://captureze.com

# HTTP transport (only used with --http)
PORT=8787
HOST=127.0.0.1
# Comma-separated Host header allowlist when binding to 0.0.0.0 behind a proxy
CAPTUREZE_MCP_ALLOWED_HOSTS=

# Capture requests are slow (real browser + proxy escalation). Milliseconds.
CAPTUREZE_TIMEOUT_MS=180000

# Above this size a capture comes back as a URL instead of inline base64 image data.
CAPTUREZE_MAX_INLINE_IMAGE_BYTES=4500000
