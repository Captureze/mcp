{
  "name": "@captureze/mcp",
  "version": "0.1.0",
  "description": "Model Context Protocol server for Captureze — scheduled website screenshots, visual diffs and capture certificates for AI agents",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "captureze-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "docs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('fs').chmodSync('dist/index.js', 0o755)\"",
    "dev": "node --experimental-strip-types src/index.ts",
    "http": "node --experimental-strip-types src/index.ts --http",
    "test": "node --experimental-strip-types --test \"src/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "captureze",
    "screenshot",
    "visual-diff",
    "agent",
    "claude",
    "chatgpt"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "^5.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.9.3"
  }
}
